{
  "name": "jerp-source-led-film",
  "version": "1.0.0",
  "private": true,
  "description": "JERP 49-second source-led 3D marketing film",
  "scripts": {
    "studio": "remotion studio entry.ts --browser-executable=/usr/bin/chromium",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions entry.ts --browser-executable=/usr/bin/chromium",
    "render": "node scripts/render.mjs",
    "stills": "node scripts/render.mjs stills",
    "draft": "node scripts/render.mjs draft",
    "mux": "node scripts/mux.mjs",
    "hyperframes:audio": "HYPERFRAMES_NO_TELEMETRY=1 hyperframes audio output/master-audio.wav --quality fast --only loudness,silence,moments --json",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/three": "4.0.538",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "gsap": "3.15.0",
    "hyperframes": "0.8.198",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "three": "0.186.1",
    "typescript": "7.0.2"
  }
}
